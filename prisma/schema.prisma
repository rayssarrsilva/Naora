// Naora · data model.
// Multi-tenant: every row of business data belongs to exactly one Business, and every query
// that reads or writes it goes through the owner's membership (src/lib/business/repository.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  STAFF
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// A salon, barbershop or studio.
model Business {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  timezone  String         @default("America/Sao_Paulo")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   Membership[]
  services  Service[]
  hours     OpeningHours[]
  bookings  Booking[]
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  accounts      Account[]
}

/// Who works where, and with which permissions.
model Membership {
  id         String   @id @default(cuid())
  role       Role     @default(STAFF)
  businessId String
  userId     String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

/// Something a client can book: a haircut, a manicure, a training session.
model Service {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  durationMin  Int
  /// Prices in cents (BRL), never floats.
  priceCents   Int
  depositCents Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@index([businessId])
}

/// When the business opens, one row per open weekday. Times are minutes after midnight, local time.
model OpeningHours {
  id         String   @id @default(cuid())
  businessId String
  /// 0 = Sunday … 6 = Saturday, like JavaScript's Date#getDay.
  weekday    Int
  opensAt    Int
  closesAt   Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, weekday])
}

/// A client's appointment. The service is copied at booking time, so editing or deleting the service
/// later never changes what the client booked. Two confirmed bookings of the same business never
/// overlap: createBooking checks and inserts under a per-business lock (src/lib/booking/repository.ts).
model Booking {
  id           String        @id @default(cuid())
  businessId   String
  serviceId    String?
  serviceName  String
  durationMin  Int
  priceCents   Int
  depositCents Int
  clientName   String
  /// Digits only, with the area code: 34991234567.
  clientPhone  String
  startsAt     DateTime
  endsAt       DateTime
  status       BookingStatus @default(CONFIRMED)
  createdAt    DateTime      @default(now())
  cancelledAt  DateTime?
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([businessId, startsAt])
  @@index([serviceId])
}

/// OAuth accounts (Google), managed by Auth.js.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}
