# Postgres. With Docker: docker compose up -d db, then use the line below.
DATABASE_URL=postgresql://naora:naora@localhost:5432/naora

# Public address, used in metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sessions are signed with this. Generate one with: npx auth secret
AUTH_SECRET=

# Optional: Google sign-in (console.cloud.google.com → Credentials → OAuth client).
# Without them, only the one-click demo account is offered.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set to "off" to hide the one-click demo account.
DEMO_LOGIN=

# Optional: lets businesses connect their own Mercado Pago account for the Pix deposit. Their
# tokens are stored encrypted with this key: 32 random bytes in base64 (openssl rand -base64 32).
# Without it, demo businesses still get a simulated Pix; others arrange the deposit in person.
PAYMENTS_KEY=
